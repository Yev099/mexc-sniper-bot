# === MEXC API Keys (Master Account) ===
MEXC_API_KEY=
MEXC_API_SECRET=

# === Follower Accounts ===
# Format: NAME:API_KEY:API_SECRET:RATIO
# RATIO = position multiplier (1.0 = same size as master, 0.5 = half, 2.0 = double)
FOLLOWERS=

# === Telegram Bot (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Settings ===
POLL_INTERVAL=0.5
DEFAULT_LEVERAGE=20
COPY_LIMIT_ORDERS=true
COPY_TP_SL=true
