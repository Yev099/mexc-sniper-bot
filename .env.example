# === MEXC API Keys (Master Account) ===
MEXC_API_KEY=
MEXC_API_SECRET=

# === Followers with API keys ===
# Format: NAME:API_KEY:API_SECRET:RATIO (comma-separated)
# RATIO: 1.0 = same volume, 0.5 = half, 2.0 = double
FOLLOWERS=

# === Followers with Cookie (u_id) auth — no API keys needed ===
# Format: NAME|U_ID|RATIO|PROXY|USER_AGENT (pipe-separated, comma between accounts)
# PROXY and USER_AGENT are optional
# How to get u_id: browser DevTools → Network → any futures.mexc.com request → Authorization header
FOLLOWERS_COOKIE=

# === Telegram Bot (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Settings ===
POLL_INTERVAL=0.5
DEFAULT_LEVERAGE=20
COPY_LIMIT_ORDERS=true
COPY_TP_SL=true
